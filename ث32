                                        salesProfit += (soldQty * dynamicSellPrice);
                                        newInventory[prodKey] -= soldQty;
                                        somethingChanged = true;
                                    }
                                    newSalesProgress[prodKey] = remainingProg;
                                    somethingChanged = true;
                                }
                            });
