                    })
                    .catch((registrationError) => {
                        console.log('SW registration failed: ', registrationError);
                    });
            });
        }
        
        // Remove Intro Overlay after 6 seconds (updated)
        setTimeout(() => {
            const intro = document.getElementById('intro-overlay');
            if(intro) {
                intro.style.display = 'none';
            }
        }, 6000);
